.bkit/

# Claude Code — keep project settings, exclude personal overrides
.claude/settings.local.json
.claude/cache/
.claude/sessions/
.claude/worktrees/

# Temporary
*.tmp
*.bak~

# Python (Phase 5 backend)
.venv/
__pycache__/
*.pyc
*.pyo

# Playwright
playwright-report/
test-results/
.playwright/
.vercel
