# Sixsense .env 템플릿. 실제 값으로 채워서 ~/Documents/my-project/.env 로 저장.
# ⚠️ .env 는 .gitignore 에 등록 — 절대 git commit 하지 말 것.

# ──────────────────────────────────────────────────────────────
# LLM API (1개 이상 권장, fallback chain 으로 작동)
# ──────────────────────────────────────────────────────────────

# Anthropic Claude (1순위 - 가장 정확, $5 충전 권장)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Google Gemini (2순위 - 무료 1500 req/day)
# https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=AIzaxxxxxxxxxxx

# Groq (3순위 - 무료 14400 req/day, fallback 권장 추가)
# https://console.groq.com → "Create API Key"
GROQ_API_KEY=gsk_xxxxxxxxxxx

# ──────────────────────────────────────────────────────────────
# 데이터 API (모두 무료, 발급 5~30분)
# ──────────────────────────────────────────────────────────────

# 통계청 KOSIS — A-4 재고지수 등
# https://kosis.kr/openapi → 가입 → 인증키 발급
KOSIS_API_KEY=
KOSIS_FULL_URL=https://kosis.kr/openapi/Param/statisticsParameterData.do?method=...

# 관세청 data.go.kr — A-3 메모리 수출
# https://www.data.go.kr → "Itemtrade" 검색 → 활용신청
KCS_API_KEY=
KCS_API_URL=https://apis.data.go.kr/1220000/Itemtrade

# AWS Spot 가격 — A-5 (선택)
# https://console.aws.amazon.com/iam → 사용자 생성 → Access key 발급
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ──────────────────────────────────────────────────────────────
# Supabase (운영 시 데이터 영속화, 시범 단계는 선택)
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ──────────────────────────────────────────────────────────────
# Reddit (선택, B-3 대안)
# ──────────────────────────────────────────────────────────────
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────
# Google BigQuery (선택, B-2 GDELT 대안)
# ──────────────────────────────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json
