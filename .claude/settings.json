{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-commit.sh",
            "timeout": 600,
            "statusMessage": "커밋 전 검증(verify.sh) 실행 중…"
          }
        ]
      }
    ]
  }
}
