# Sixsense backend — 자동 수집을 위한 환경변수
# 사용법:
#   cp .env.example .env
#   .env 파일을 편집하여 본인의 키를 입력
#   터미널에서: source .env  (또는 backend/ 폴더에서 collector 실행 전 export)

# ─── A-3 관세청 무역통계 API ────────────────────────────────────────────────
# 발급: https://unipass.customs.go.kr/ets/index.do
#   1. 회원가입 → 마이페이지 → OpenAPI 이용 신청
#   2. 활용 목적 입력 → 승인 (1~3 영업일)
#   3. 마이페이지 → 인증키 복사
# 무료, 일 1만건 호출 제한
KCS_API_KEY=

# ─── A-4 KOSIS 통계청 API ───────────────────────────────────────────────────
# 발급: https://kosis.kr/openapi/index/index.jsp
#   1. 회원가입 → 활용신청 → 즉시 발급
# 무료, 일 1만건 호출 제한
KOSIS_API_KEY=

# ─── A-5 AWS Spot price ────────────────────────────────────────────────────
# 발급: https://console.aws.amazon.com/iam → Users → Security credentials
#   1. AWS 계정 생성 (결제카드 필수, free tier 12개월)
#   2. IAM user 생성 → AmazonEC2ReadOnlyAccess 권한 부여
#   3. Access key 생성 → Access key ID + Secret access key
# 무료 (read-only 호출)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── B-1, B-5, B-6 Claude API (IR sentiment) ──────────────────────────────
# 발급: https://console.anthropic.com → API Keys → Create Key
#   1. Anthropic 계정 생성 (즉시)
#   2. 결제 정보 등록 → 종량제 ($3~$15/M tokens)
#   3. 분기당 3사 IR PDF × 4분기 = 12회 호출 ≈ $1 미만
ANTHROPIC_API_KEY=

# ─── B-2 Google BigQuery (GDELT) ───────────────────────────────────────────
# 발급: https://console.cloud.google.com
#   1. GCP 프로젝트 생성 (결제카드 필수, 1TB/월 free tier)
#   2. IAM → Service Accounts → Create → BigQuery Data Viewer + Job User
#   3. JSON key 다운로드 → 파일 경로를 아래 환경변수로 지정
# GDELT 쿼리 1회 ≈ 50MB 정도 (한 달 200회 쿼리 가능 free)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# ─── B-3 Reddit PRAW ───────────────────────────────────────────────────────
# 발급: https://www.reddit.com/prefs/apps (즉시)
#   1. Reddit 계정 로그인 → 위 페이지 → "create another app"
#   2. type=script, name=Sixsense, redirect_uri=http://localhost (무관)
#   3. 생성된 client ID (제목 아래 14자) + secret 복사
# 무료, 분당 60회
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
